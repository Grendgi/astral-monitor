{
  "vantage": "astral-id",
  "role": "secondary",
  "intervalSec": 60,
  "failThreshold": 3,
  "recoverThreshold": 2,
  "certWarnDays": 14,
  "remindHours": 6,
  "heartbeatHourMSK": 9,
  "peerStaleCycles": 5,
  "peer": {
    "name": "frankfurt",
    "ssh": "root@78.17.115.31",
    "keyFile": "/opt/astral-monitor/peer_key"
  },
  "stateDir": "/var/lib/astral-monitor",
  "silenceFile": "/opt/astral-monitor/silence",
  "checks": [
    {
      "name": "panel",
      "label": "VPN panel",
      "type": "https",
      "url": "https://panel.astralnet.io/",
      "expect": [
        200,
        302
      ]
    },
    {
      "name": "panel-api",
      "label": "VPN panel API",
      "type": "https",
      "url": "https://panel.astralnet.io/api/health",
      "expect": [
        401
      ],
      "bodyContains": "unauthorized"
    },
    {
      "name": "vpn-direct",
      "label": "VPN panel direct (MSK :8443 via awg-mgmt)",
      "type": "https",
      "url": "https://10.20.0.11:8443/api/health",
      "expect": [
        401
      ],
      "insecure": true,
      "bodyContains": "unauthorized"
    },
    {
      "name": "sub",
      "label": "VPN subscriptions",
      "type": "https",
      "url": "https://sub.astralnet.io/",
      "expect": [
        200,
        302
      ]
    },
    {
      "name": "portal",
      "label": "VPN client portal",
      "type": "https",
      "url": "https://sub.astralnet.io/portal/api/status",
      "expect": [
        200
      ],
      "bodyContains": "\"enabled\":true"
    },
    {
      "name": "haproxy",
      "label": "Proxy panel",
      "type": "https",
      "url": "https://haproxy.astralnet.io/",
      "expect": [
        403
      ]
    },
    {
      "name": "id",
      "label": "astral ID",
      "type": "https",
      "url": "https://id.astralnet.io/readyz",
      "expect": [
        200
      ],
      "jsonReady": true
    },
    {
      "name": "console",
      "label": "astral ID console",
      "type": "https",
      "url": "https://console.astralnet.io/",
      "expect": [
        302
      ]
    },
    {
      "name": "status",
      "label": "status page",
      "type": "https",
      "url": "https://status.astralnet.io/",
      "expect": [
        200
      ]
    },
    {
      "name": "status-json",
      "label": "status.json",
      "type": "https",
      "url": "https://status.astralnet.io/status.json",
      "expect": [
        200
      ],
      "bodyContains": "\"services\""
    },
    {
      "name": "smtp-mx",
      "label": "inbound mail (MX :25)",
      "type": "smtp",
      "addr": "mx.astralnet.io:25",
      "starttls": true,
      "serverName": "mail.astralnet.io",
      "timeoutSec": 15
    },
    {
      "name": "site",
      "label": "astralnet.io site",
      "type": "https",
      "url": "https://astralnet.io/",
      "expect": [
        200
      ]
    },
    {
      "name": "imaps",
      "label": "IMAPS (mail clients)",
      "type": "tls",
      "addr": "mail.astralnet.io:993",
      "serverName": "mail.astralnet.io",
      "banner": "* OK",
      "timeoutSec": 15
    },
    {
      "name": "smtps",
      "label": "submissions :465",
      "type": "tls",
      "addr": "mail.astralnet.io:465",
      "serverName": "mail.astralnet.io",
      "banner": "220",
      "timeoutSec": 15
    },
    {
      "name": "mail-account",
      "label": "mailbox /account (app passwords)",
      "type": "https",
      "url": "https://mailbox.astralnet.io/account/",
      "expect": [
        200
      ]
    },
    {
      "name": "notify-hub",
      "label": "astral-notify hub",
      "type": "https",
      "url": "http://127.0.0.1:9311/healthz",
      "expect": [
        200
      ],
      "bodyContains": "\"ok\":true"
    },
    {
      "name": "backup-astral-id",
      "label": "astral ID backup fresh (<26h)",
      "type": "file-age",
      "glob": "/var/backups/astral-id/astral-id-*",
      "maxAgeHours": 26
    },
    {
      "name": "backup-stalwart",
      "label": "Stalwart backup fresh (<26h)",
      "type": "file-age",
      "glob": "/var/backups/stalwart/stalwart-*.tar.gz.age",
      "maxAgeHours": 26
    },
    {
      "name": "dns-cloudflare",
      "label": "DNS via 1.1.1.1",
      "type": "dns",
      "server": "1.1.1.1:53",
      "lookups": [
        {
          "type": "MX",
          "name": "astralnet.io",
          "expect": "mx.astralnet.io"
        },
        {
          "type": "A",
          "name": "mx.astralnet.io",
          "expect": "95.181.212.217"
        },
        {
          "type": "A",
          "name": "panel.astralnet.io",
          "expect": "95.181.212.217"
        },
        {
          "type": "A",
          "name": "id.astralnet.io",
          "expect": "95.181.212.217"
        },
        {
          "type": "A",
          "name": "mail.astralnet.io",
          "expect": "87.58.213.25"
        }
      ]
    },
    {
      "name": "dns-google",
      "label": "DNS via 8.8.8.8",
      "type": "dns",
      "server": "8.8.8.8:53",
      "lookups": [
        {
          "type": "MX",
          "name": "astralnet.io",
          "expect": "mx.astralnet.io"
        },
        {
          "type": "A",
          "name": "mx.astralnet.io",
          "expect": "95.181.212.217"
        },
        {
          "type": "A",
          "name": "panel.astralnet.io",
          "expect": "95.181.212.217"
        },
        {
          "type": "A",
          "name": "id.astralnet.io",
          "expect": "95.181.212.217"
        },
        {
          "type": "A",
          "name": "mail.astralnet.io",
          "expect": "87.58.213.25"
        }
      ]
    }
  ]
}
